.claude/
.foundry/
node_modules/
graphify-out/
.graphify_python
.graphify_python (1)
launch-your-agent/

# Duplicate app forks (live copies; edit root app/ only unless asked)
wf/
wh2/

# One-off diagnostics / local scripts
tools/
scripts/
cron/

# Heavy / generated / static vendor (CDN used for most UI)
assets/vendor/
assets/uploads/
assets/pwa/**/icons/
