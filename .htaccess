# InvenTrack Pro — minimal secure profile

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    # Override long-cache for PWA service worker + manifest (must stay fresh)
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header unset Pragma
    </FilesMatch>
    # Each customer PWA SW may only control its declared scope
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/assets/pwa/apps/sw\.js$" SW_SCOPE_APPS
        SetEnvIf Request_URI "^/assets/pwa/imei/sw\.js$" SW_SCOPE_IMEI
        SetEnvIf Request_URI "^/assets/pwa/pricelist/sw\.js$" SW_SCOPE_PRICELIST
    </IfModule>
    Header set Service-Worker-Allowed "/" env=SW_SCOPE_APPS
    Header set Service-Worker-Allowed "/imei" env=SW_SCOPE_IMEI
    Header set Service-Worker-Allowed "/pricelist" env=SW_SCOPE_PRICELIST

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Camera allowed for public IMEI barcode scan PWA; mic/geo still blocked.
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    # Enforcing CSP (Report-Only without report-uri is no-op). This app still relies on inline scripts/styles and some CDN libs.
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://code.jquery.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Correct MIME for PWA manifest + local fonts
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Deny direct access to sensitive paths
RedirectMatch 403 ^/(config|app|backups|database|cron|api/v1(?:/|$)|graphify-out|\.claude|\.idea|\.vscode|\.vs)(/.*)?$
RedirectMatch 403 ^/\.git(?:/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/.*)?$ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.gitignore - [F,L]
    RewriteRule ^\.user(\.ini)?$ - [F,L]

    # Unified customer apps hub (single PWA → Warranty / Service / Pricelist / Order)
    # Route via index.php (same pattern as /imei) so it works without a root apps.php upload
    RewriteRule ^apps/?$ index.php?page=appshub [L,QSA,NC]
    RewriteRule ^apps/order/status/?$ index.php?page=appsorder&action=status [L,QSA,NC]
    RewriteRule ^apps/order/?$ index.php?page=appsorder [L,QSA,NC]

    # Short URL for public order requests (prior confirmation)
    RewriteRule ^order/status/?$ index.php?page=appsorder&action=status [L,QSA,NC]
    RewriteRule ^order/?$ index.php?page=appsorder [L,QSA,NC]

    # Pretty URL for public IMEI warranty tracking
    # Never rewrite real files/dirs under /imei/ (PWA leftovers or future static assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^imei/ - [L]
    RewriteRule ^imei/?$ index.php?page=imeitrack [L,QSA,NC]
    RewriteRule ^imei/([^/]+)/?$ index.php?page=imeitrack&imei=$1 [L,QSA,NC]

    # Pretty URL for public pricelist (same pattern as /imei)
    RewriteRule ^pricelist/?$ pricelist.php [L,QSA,NC]

    # Short URL for service repair tracking (IMEI digits or hex token in path)
    RewriteRule ^service/(\d{14,18})/?$ index.php?page=servicetrack&imei=$1 [L,QSA,NC]
    RewriteRule ^service/([a-fA-F0-9]{16,64})/?$ index.php?page=servicetrack&token=$1 [L,QSA,NC]
    RewriteRule ^service/?$ index.php?page=servicetrack [L,QSA,NC]

    # Short URL for public customer statements (legacy 32-char hex or new base64url tokens)
    RewriteRule ^s/([A-Za-z0-9_-]{8,64})/?$ statement.php?token=$1 [L,QSA,NC]

    # Manpower invoice-pack verification QR (signed token)
    RewriteRule ^v/([A-Za-z0-9._-]+)/?$ index.php?page=verify&token=$1 [L,QSA,NC]

    # PO bank-document pack verification QR (signed token)
    RewriteRule ^d/([A-Za-z0-9._-]+)/?$ index.php?page=podocsverify&token=$1 [L,QSA,NC]

    # Payment receipt verification QR (signed token)
    RewriteRule ^r/([A-Za-z0-9._-]+)/?$ index.php?page=paymentverify&token=$1 [L,QSA,NC]
</IfModule>

<FilesMatch "^\.env|^\.ht|^\.user\.ini$|^user\.ini$|^\.user$|\.sql$|\.php\.bak$|\.php\.old$|\.php\.swp$|\.php~$|\.log$|\.bak$|\.old$|\.swp$|~$|\.(md|markdown|code-workspace|yml|yaml|toml|lock)$|^(composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
